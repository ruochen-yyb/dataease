{
  "compilerOptions": {
    "jsx": "preserve",
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strictFunctionTypes": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "experimentalDecorators": true,
    "noImplicitAny": false,
    "noEmit": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": [
      "vite/client",
      "vite-plugin-svg-icons/client",
      "element-plus-secondary/global",
    ],
  },
  "include": [
    "src/**/*",
    "electron-main/**/*.ts",
    "types/**/*.d.ts",
    "types"
  ],
  "exclude": [
    // ts:check 默认不允许 JS 文件；src 下存在少量历史 .js 文件，排除以避免 TS6504
    "src/**/*.js",
    "dist",
    "lib",
    "node_modules",
  ]
}